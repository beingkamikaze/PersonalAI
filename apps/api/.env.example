# Copy to apps/api/.env and fill in values from Supabase / LLM provider.
# Never commit the real .env file.

# Direct or pooler URI — postgresql:// is auto-upgraded to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Exact Project URL from Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Same publishable/anon key as apps/web/.env.local (required for token verify)
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: only if JWKS / Auth API verify fails and project has Legacy HS256 secret
# SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM chat — pick ONE provider
# ---------------------------------------------------------------------------

# Option A — OpenAI platform (chat + embeddings)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option B — Azure OpenAI for chat
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
#
# Embeddings when on Azure — pick ONE:
#   B1) Create an embedding deployment in the same Azure resource, then:
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
#   B2) Keep chat on Azure; use platform OpenAI only for embeddings:
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Cloudflare R2 — avatars (S3-compatible)
# ---------------------------------------------------------------------------
# Account ID: R2 overview right sidebar, or dash.cloudflare.com/<id>/r2
# Keys: R2 → Manage R2 API Tokens → Create Account API token (Object Read & Write)
# Public URL: bucket Settings → Public Development URL → Enable
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AVATARS=personaai-avatars
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ---------------------------------------------------------------------------
# Phase 2 — knowledge / RAG
# ---------------------------------------------------------------------------
# UPLOAD_DIR=uploads
# MAX_UPLOAD_BYTES=8388608
# MAX_AVATAR_BYTES=2097152
# RAG_TOP_K=6
# MEMORY_MIN_IMPORTANCE=0.55
# MEMORY_MIN_CONFIDENCE=0.6
# MEMORY_TOP_K=8
# PUBLIC_CHAT_RATE_LIMIT=20
# PUBLIC_CHAT_RATE_WINDOW_SECONDS=3600
# CHAT_MAX_INPUT_CHARS=2000
# CHAT_MAX_OUTPUT_CHARS=2500
# FREE_OWNER_CHATS_PER_DAY=40
# FREE_MAX_DOCUMENTS=8
# LLM_OMIT_TEMPERATURE=false

# Optional: DEBUG for more verbose logs (default INFO)
# LOG_LEVEL=INFO
